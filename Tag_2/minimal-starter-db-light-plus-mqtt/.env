## Lokale Overrides (optional)
# DB_DSN=postgresql://appuser:apppass@localhost:5432/appdb

# PostgreSQL
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppass

POSTGRES_HOST=db
POSTGRES_CONTAINER_PORT=5432
POSTGRES_HOST_PORT=5432

# PostgreSQL init scripts
DB_INIT_DIR=./db/init


# API / FastAPI
API_HOST=0.0.0.0
API_CONTAINER_PORT=8000
API_HOST_PORT=8000


# MQTT / Mosquitto
MQTT_HOST=mqtt

MQTT_PORT=1883
MQTT_WS_PORT=9001

MQTT_HOST_PORT=1883
MQTT_WS_HOST_PORT=9001


# Python
PYTHONUNBUFFERED=1